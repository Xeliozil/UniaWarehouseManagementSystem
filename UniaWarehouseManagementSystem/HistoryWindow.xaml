<Window x:Class="UniaWarehouseManagementSystem.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        mc:Ignorable="d"
        Title="Historia Dokumentów" Height="600" Width="950">

    <Window.DataContext>
        <vm:HistoryViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Rejestr" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Data:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Width="100"/>
                        <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                        <TextBlock Text="Typ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding DocTypes}" SelectedItem="{Binding SelectedDocType}" Width="80"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kontrahent:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding Contractors}" 
                          SelectedItem="{Binding SelectedContractor}" 
                          DisplayMemberPath="Name"
                          Width="180"/>
                        <Button Content="❌" Command="{Binding ClearContractorCommand}" 
                        ToolTip="Wyczyść kontrahenta (Pokaż wszystkich)"
                        Background="Transparent" BorderThickness="0" Foreground="Red" Margin="2,0,0,0"/>
                    </StackPanel>

                </WrapPanel>

                <Button Grid.Column="2" Content="📊 Drukuj Listę (PDF)" Command="{Binding GeneratePeriodReportCommand}" 
                Padding="15,5" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Documents}" 
                  SelectedItem="{Binding SelectedDocument}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" 
                  SelectionMode="Single"
                  BorderBrush="#CCC" BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Binding="{Binding DocDate, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>

                <DataGridTextColumn Header="Typ" Binding="{Binding DocType}" Width="60" FontWeight="Bold"/>

                <DataGridTextColumn Header="Numer" Binding="{Binding Number}" Width="180"/>
                <DataGridTextColumn Header="Kontrahent" Binding="{Binding Contractor.Name}" Width="*"/>

                <DataGridTextColumn Header="Pozycji" Binding="{Binding Items.Count}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray"/>

            <Button Content="🖨️ DRUKUJ ZAZNACZONY DOKUMENT" Command="{Binding PrintDocumentCommand}" 
                    Padding="20,10" Background="#FFC107" FontWeight="Bold" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>