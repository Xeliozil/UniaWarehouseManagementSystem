<Window x:Class="UniaWarehouseManagementSystem.UserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        Title="Nowy Użytkownik" Height="350" Width="350" ResizeMode="NoResize">

    <Window.DataContext>
        <vm:UserEditorViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Dodawanie Użytkownika" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Nazwa Użytkownika (Login):" FontWeight="Bold"/>
            <TextBox Text="{Binding Username}" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Hasło:" FontWeight="Bold"/>
            <TextBox Text="{Binding Password}" Padding="5" Margin="0,0,0,10"/>

            <TextBlock Text="Uprawnienia:" FontWeight="Bold"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Padding="5" Margin="0,0,0,20"/>

            <Button Content="ZAPISZ KONTO" Command="{Binding SaveCommand}" 
                    Height="40" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>