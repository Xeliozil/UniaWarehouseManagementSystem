<Window x:Class="UniaWarehouseManagementSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        Title="Unia WMS - Logowanie" Height="300" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Border BorderBrush="#2196F3" BorderThickness="2">
        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="UNIA WMS" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2196F3" Margin="0,0,0,20"/>

                <TextBlock Text="Użytkownik:"/>
                <TextBox Text="{Binding Username}" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Hasło:"/>
                <PasswordBox x:Name="UserPasswordBox" Margin="0,0,0,20" Padding="5"/>

                <Button Content="ZALOGUJ" 
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=UserPasswordBox}"
                        Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold"/>

                <Button Content="Wyjście" 
                        Command="{Binding ExitCommand}" 
                        IsCancel="True" 
                        Margin="0,10,0,0" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="Gray"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>