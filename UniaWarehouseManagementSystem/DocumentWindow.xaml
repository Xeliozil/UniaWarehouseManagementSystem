<Window x:Class="UniaWarehouseManagementSystem.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        mc:Ignorable="d"
        Title="Nowy Dokument PZ" Height="500" Width="800">

    <Window.DataContext>
        <vm:DocumentEditorViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#CCC" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,15,0" Visibility="{Binding ShowSource}">
                        <TextBlock Text="Magazyn Źródłowy:" FontWeight="Bold" Foreground="#D32F2F"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" 
                          SelectedItem="{Binding SourceWarehouse}" 
                          DisplayMemberPath="Name" 
                          Width="180"/>
                    </StackPanel>

                    <TextBlock Text="➔" VerticalAlignment="Center" FontSize="18" Margin="0,15,15,0" Visibility="{Binding ShowSource}"/>

                    <StackPanel Margin="0,0,20,0" Visibility="{Binding ShowTarget}">
                        <TextBlock Text="Magazyn Docelowy:" FontWeight="Bold" Foreground="#388E3C"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" 
                          SelectedItem="{Binding TargetWarehouse}" 
                          DisplayMemberPath="Name" 
                          Width="180"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Numer:" FontWeight="Bold"/>
                        <TextBox Text="{Binding DocumentNumber}" IsReadOnly="True" Background="#EEE" Width="140"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Visibility="{Binding ShowContractor}">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Kontrahent (Dostawca/Odbiorca):" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding FilteredContractors}" 
                          SelectedItem="{Binding SelectedContractor}"
                          DisplayMemberPath="DisplayName" 
                          Width="300"/>
                    </StackPanel>

                    <Button Content="+" Command="{Binding AddNewContractorQuicklyCommand}" 
                    Width="30" Height="30" VerticalAlignment="Bottom" FontWeight="Bold" 
                    FontSize="16" Background="#EEE"
                    ToolTip="Dodaj nowego kontrahenta"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F9F9F9" Padding="10">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Wybierz Produkt:"/>
                    <ComboBox ItemsSource="{Binding Products}" 
                      SelectedItem="{Binding CurrentProduct}"
                      DisplayMemberPath="Name" 
                      Width="250"/>

                    <TextBlock Text="{Binding StockInfo}" Foreground="Red" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Ilość:"/>
                    <TextBox Text="{Binding CurrentQuantity}" Width="80" TextAlignment="Center"/>
                </StackPanel>

                <Button Content="DODAJ DO LISTY" Command="{Binding AddToCartCommand}" 
                VerticalAlignment="Bottom" Padding="15,2" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" Margin="0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod" Binding="{Binding Product.Code}" Width="80"/>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Product.Name}" Width="*"/>
                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="80" FontWeight="Bold"/>
                <DataGridTextColumn Header="J.m." Binding="{Binding Product.Unit}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ZAPISZ DOKUMENT" Command="{Binding SaveDocumentCommand}" 
                    Padding="20,10" Background="#4CAF50" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>