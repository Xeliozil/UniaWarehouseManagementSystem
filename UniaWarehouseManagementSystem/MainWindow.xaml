<Window x:Class="UniaWarehouseManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        mc:Ignorable="d"
        Title="System Unia - Gospodarka Materiałowa" Height="600" Width="1400">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Katalog Produktów" FontSize="24" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="16"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="300" Padding="5" VerticalContentAlignment="Center" FontSize="14"
                         Tag="Wpisz nazwę produktu..."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserInfo}" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <Button Content="Wyloguj 🔒" Command="{Binding LogoutCommand}" 
                        Padding="10,4" Margin="0,0,5,0" Background="#FFEBEE" Foreground="#D32F2F" BorderBrush="#FFCDD2"/>

                        <Button Content="Wyłącz ❌" Command="{Binding ExitAppCommand}" 
                        Padding="10,4" Background="#333" Foreground="White" FontWeight="Bold" ToolTip="Zamknij program"/>
                    </StackPanel>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1" Orientation="Horizontal">

                <Border BorderBrush="#DDD" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="+ PZ" Command="{Binding OpenNewPzCommand}" Margin="0,0,5,0" Padding="15,6" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button Content="- WZ" Command="{Binding OpenNewWzCommand}" Margin="0,0,5,0" Padding="15,6" Background="#F44336" Foreground="White" FontWeight="Bold"/>
                        <Button Content="➔ MM" Command="{Binding OpenNewMmCommand}" Padding="15,6" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                        
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0" Visibility="{Binding AdminVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="➕ Produkt" Command="{Binding OpenAddProductCommand}" Margin="0,0,5,0" Padding="10,6" Background="#EEE"/>
                        <Button Content="✏️ Edytuj" Command="{Binding OpenEditProductCommand}" Margin="0,0,5,0" Padding="10,6" Background="#EEE"/>
                        <Button Content="👤 Kontrahent" Command="{Binding OpenNewContractorCommand}" Padding="10,6" Background="#EEE"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD" BorderThickness="0,0,1,0" Margin="0,0,10,0" Padding="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔄 Odśwież" Command="{Binding LoadDataCommand}" Margin="0,0,5,0" Padding="10,6"/>
                        <Button Content="🖨️ PDF" Command="{Binding GenerateReportCommand}" Margin="0,0,5,0" Padding="10,6" Background="#FFEB3B"/>
                        <Button Content="🗂️ Historia" Command="{Binding OpenHistoryCommand}" Margin="0,0,5,0" Padding="10,6" Background="#2196F3" Foreground="White"/>
                        <Button Content="📊 Dashboard" Command="{Binding OpenStatsCommand}" Margin="0,0,5,0" Padding="10,6" Background="#9C27B0" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding AdminVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📥 Import CSV" Command="{Binding ImportProductsCommand}" Margin="0,0,5,0" Padding="10,6" Background="#009688" Foreground="White" FontWeight="Bold" ToolTip="Format pliku: Kod;Nazwa;Jm;MinStan"/>
                        <Button Content="👤+ Dodaj użytkownika" Command="{Binding OpenNewUserCommand}" Margin="0,0,5,0" Padding="10,6" Background="#E0E0E0" FontWeight="Bold"/>
                        <Button Content="⚙️ Ustawienia" Command="{Binding OpenSettingsCommand}" Padding="10,6" Background="#E0E0E0" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Grid>

        <DataGrid Grid.Row="1" 
          ItemsSource="{Binding ProductsList}" 
          SelectedItem="{Binding SelectedProduct}" 
          AutoGenerateColumns="False" 
          IsReadOnly="True"
          SelectionMode="Single"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          BorderThickness="1"
          BorderBrush="#CCC">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                            <Setter Property="Background" Value="#FFCDD2"/>
                            <Setter Property="Foreground" Value="#B71C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="100" FontWeight="Bold"/>
                <DataGridTextColumn Header="Nazwa Produktu" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="J.m." Binding="{Binding Unit}" Width="60"/>

                <DataGridTextColumn Header="Stan Razem" Binding="{Binding TotalQuantity}" Width="90" FontWeight="Bold"/>

                <DataGridTextColumn Header="Min. Stan" Binding="{Binding MinStock}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Margin="0,10,0,0" Background="#F0F0F0" Padding="5">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>