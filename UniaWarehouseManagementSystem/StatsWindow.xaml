<Window x:Class="UniaWarehouseManagementSystem.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UniaWarehouseManagementSystem.ViewModels"
        Title="Pulpit Kierownika - Dashboard" Height="500" Width="850" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.DataContext>
        <vm:StatsViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFEBEE" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="⚠️ BRAKI" Foreground="#D32F2F" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding LowStockCount}" FontSize="36" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                    <TextBlock Text="produktów poniżej minimum" FontSize="11" Foreground="#D32F2F" Opacity="0.8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#E3F2FD" BorderBrush="#42A5F5" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="📦 KARTOTEKI" Foreground="#1565C0" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding TotalProductsCount}" FontSize="36" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Right"/>
                    <TextBlock Text="zdefiniowanych towarów" FontSize="11" Foreground="#1565C0" Opacity="0.8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#E8F5E9" BorderBrush="#66BB6A" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                <StackPanel>
                    <TextBlock Text="🏭 STAN OGÓŁEM" Foreground="#2E7D32" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding TotalStockSum}" FontSize="36" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Right"/>
                    <TextBlock Text="sztuk na magazynie" FontSize="11" Foreground="#2E7D32" Opacity="0.8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#FFF3E0" BorderBrush="#FFA726" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="📄 DOKUMENTY" Foreground="#EF6C00" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding DocsThisMonth}" FontSize="36" FontWeight="Bold" Foreground="#EF6C00" HorizontalAlignment="Right"/>
                    <TextBlock Text="w tym miesiącu" FontSize="11" Foreground="#EF6C00" Opacity="0.8" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="🚨 Lista towarów do zamówienia (Stan poniżej minimum)" FontSize="16" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Nazwa Produktu" Binding="{Binding Name}" Width="*"/>

                <DataGridTextColumn Header="Stan Obecny" Binding="{Binding TotalQuantity}" Width="100" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="0,0,10,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Minimum" Binding="{Binding MinStock}" Width="80" Foreground="Gray"/>
                <DataGridTextColumn Header="J.m." Binding="{Binding Unit}" Width="50"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Zamknij" IsCancel="True" Margin="0,15,0,0" HorizontalAlignment="Right" 
                Padding="25,8" Background="#EEE" BorderBrush="#CCC"/>
    </Grid>
</Window>